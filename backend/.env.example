# TechnoSpirit backend — configuration template.
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Nothing in this file is ever sent to the browser: the frontend talks to the
# API over same-origin `/api`, and no VITE_-prefixed variable exists here.

NODE_ENV=development
PORT=5000

# — Database ————————————————————————————————————
# Local: mongodb://127.0.0.1:27017/technospirit
# Atlas: mongodb+srv://<user>:<password>@<cluster>/technospirit?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/technospirit

# — Auth ————————————————————————————————————————
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production if this is missing, under 32
# characters, or still set to the placeholder below.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# — Admin bootstrap ————————————————————————————————
# Used ONCE, on first boot, to create the initial admin document. The password
# is bcrypt-hashed (cost 12) before it is persisted; the plaintext never
# reaches MongoDB. Changing ADMIN_INITIAL_PASSWORD later does NOT rewrite an
# existing admin — see backend/README.md for the reset procedure.
ADMIN_EMAIL=admin@technospirit
ADMIN_INITIAL_PASSWORD=replace-me-in-production

# — Mail (Gmail SMTP) ——————————————————————————————
# EMAIL_APP_PASSWORD is a Google *App Password* (16 characters, requires 2FA),
# NOT the account password. https://myaccount.google.com/apppasswords
# Leave both blank and the API still accepts and stores inquiries; it logs a
# delivery warning instead of sending mail.
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Where internal "new inquiry" notifications land. Defaults to EMAIL_USER.
CONTACT_RECEIVER=

# — Client ——————————————————————————————————————
# Comma-separated list of browser origins allowed to send credentialed
# requests. 5173 is `vite dev`; 4173 is `vite preview` (the production build
# run locally). In deployment this is the site's real origin, and the dev
# entries should be removed.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# — Call booking availability ————————————————————————
# The Book a Call popup renders whatever these produce; there is no hard-coded
# time anywhere in the frontend. Parsed once by config/availability.js, which is
# also where the defaults live and the file to open for anything more involved.
#
# Slots are generated in BOOKING_TIMEZONE (TechnoSpirit's working day, because
# TechnoSpirit places the call), sent to the browser as UTC instants, and shown
# to the visitor in their own timezone with the zone named beside them.
#
# BOOKING_DAYS uses JavaScript weekday numbers: 0 Sunday … 6 Saturday.
# BOOKING_BLOCKED_DATES is a comma-separated list of YYYY-MM-DD closures.
# Blank values fall back to the defaults shown in the comments.
BOOKING_TIMEZONE=America/New_York
BOOKING_DAYS=1,2,3,4,5
BOOKING_START=10:00
BOOKING_END=18:00
BOOKING_SLOT_MINUTES=30
# Minimum notice, in hours, before the earliest bookable slot.
BOOKING_LEAD_HOURS=12
# How far ahead the popup may reach.
BOOKING_HORIZON_DAYS=21
BOOKING_BLOCKED_DATES=

# — Assistant (TechnoSpirit AI) ————————————————————————
# Which provider answers /api/chat. The rest of the application is
# provider-agnostic: the system prompt, the TechnoSpirit knowledge base, the
# conversation rules, the grounding rules and the widget are all shared, so
# switching providers is this one line plus a key — no code change.
#
# Supported values:
#   groq        — official groq-sdk (default)
#   openrouter  — OpenRouter chat-completions
AI_PROVIDER=groq

# Leave the active provider's key blank and the site still works: /api/chat
# answers 503 with the contact fallback and nothing else is affected.
# NEVER commit a real key. Put real values in .env, which is gitignored.

# — Groq ————————————————————————————————————————
GROQ_API_KEY=
# Blank uses the in-code default (openai/gpt-oss-20b) — fast, and Groq's own
# migration target after the llama-3.x models were deprecated in June 2026.
# openai/gpt-oss-120b is the heavier option if grounding needs more weight.
GROQ_MODEL=

# — OpenRouter ——————————————————————————————————
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Automatic failover to the other provider when the active one fails.
# Off by default and deliberately so: silently spending a second vendor's
# credits is not a decision this code should make on your behalf.
AI_FALLBACK_ENABLED=false

# — Contact details the assistant may hand out ——————————
# NOT in knowledge/technospirit.json, because that file is committed and these
# are real. Placeholder defaults, so an unconfigured deployment reads as
# unconfigured rather than as a wrong number a visitor might actually dial.
# Never exposed to the browser — the assistant quotes them in its answers.
TECHNOSPIRIT_CONTACT_PHONE=
TECHNOSPIRIT_CONTACT_EMAIL=
