# TechnoSpirit backend — configuration template.
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Nothing in this file is ever sent to the browser: the frontend talks to the
# API over same-origin `/api`, and no VITE_-prefixed variable exists here.

NODE_ENV=development
PORT=5000

# — Database ————————————————————————————————————
# Local: mongodb://127.0.0.1:27017/technospirit
# Atlas: mongodb+srv://<user>:<password>@<cluster>/technospirit?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/technospirit

# — Auth ————————————————————————————————————————
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production if this is missing, under 32
# characters, or still set to the placeholder below.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# — Admin bootstrap ————————————————————————————————
# Used ONCE, on first boot, to create the initial admin document. The password
# is bcrypt-hashed (cost 12) before it is persisted; the plaintext never
# reaches MongoDB. Changing ADMIN_INITIAL_PASSWORD later does NOT rewrite an
# existing admin — see backend/README.md for the reset procedure.
ADMIN_EMAIL=admin@technospirit
ADMIN_INITIAL_PASSWORD=replace-me-in-production

# — Mail (Gmail SMTP) ——————————————————————————————
# EMAIL_APP_PASSWORD is a Google *App Password* (16 characters, requires 2FA),
# NOT the account password. https://myaccount.google.com/apppasswords
# Leave both blank and the API still accepts and stores inquiries; it logs a
# delivery warning instead of sending mail.
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Where internal "new inquiry" notifications land. Defaults to EMAIL_USER.
CONTACT_RECEIVER=

# — Client ——————————————————————————————————————
# Comma-separated list of browser origins allowed to send credentialed
# requests. 5173 is `vite dev`; 4173 is `vite preview` (the production build
# run locally). In deployment this is the site's real origin, and the dev
# entries should be removed.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
